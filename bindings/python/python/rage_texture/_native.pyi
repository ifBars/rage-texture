from pathlib import Path

__version__: str

class Error(Exception): ...
class UnsupportedError(Error): ...
class CorruptError(Error): ...
class StaleError(Error): ...
class ClosedError(Error): ...
class BusyError(Error): ...
class BoundsError(Error): ...

class Quality:
    @property
    def kind(self) -> str: ...
    @property
    def codec(self) -> int | None: ...
    @property
    def unfitted_blocks(self) -> int: ...
    @property
    def invalid_blocks(self) -> int | None: ...
    @property
    def is_lossless(self) -> bool: ...
    @property
    def is_confirmed(self) -> bool: ...
    @property
    def history_digest(self) -> str | None: ...
    @property
    def provisional_dependencies(self) -> int: ...

class Stats:
    @property
    def cache_hits(self) -> int: ...
    @property
    def cache_misses(self) -> int: ...
    @property
    def decodes(self) -> int: ...
    @property
    def source_bytes(self) -> int: ...
    @property
    def cache_bytes(self) -> int: ...
    @property
    def peak_cache_bytes(self) -> int: ...
    @property
    def evictions(self) -> int: ...

class Export:
    @property
    def data(self) -> bytes: ...
    @property
    def quality(self) -> list[Quality]: ...
    @property
    def input_bytes(self) -> int: ...
    @property
    def read_decode_seconds(self) -> float: ...
    @property
    def detile_seconds(self) -> float: ...
    @property
    def dds_seconds(self) -> float: ...
    @property
    def encode_seconds(self) -> float: ...
    @property
    def total_seconds(self) -> float: ...

class Texture:
    @property
    def index(self) -> int: ...
    @property
    def asset_key(self) -> int | None: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def depth(self) -> int: ...
    @property
    def mips(self) -> int: ...
    @property
    def dxgi(self) -> int: ...
    @property
    def dimension(self) -> int: ...
    @property
    def mode(self) -> int: ...
    @property
    def non_tail(self) -> int: ...
    @property
    def base(self) -> int: ...
    @property
    def meta(self) -> int: ...
    @property
    def extra(self) -> int: ...

class Store:
    def __init__(
        self,
        path: str | Path,
        cache_bytes: int = 0,
        allow_fitted: bool = False,
        *,
        decode_policy: str | None = None,
        history: str | Path | dict[str, object] | None = None,
    ) -> None: ...
    @property
    def closed(self) -> bool: ...
    def textures(self) -> list[Texture]: ...
    def texture_dds(self, texture: Texture, mips: int | None = None) -> Export: ...
    def texture_mip(
        self,
        texture: Texture,
        mip: int = 0,
        slice: int = 0,
    ) -> Export: ...
    def texture_png(
        self,
        texture: Texture,
        mip: int = 0,
        slice: int = 0,
    ) -> Export: ...
    def read_range(self, start: int, length: int) -> bytes: ...
    def read_range_result(self, start: int, length: int) -> Export: ...
    def stats(self) -> Stats: ...
    def reset(self) -> None: ...
    def refresh(self) -> None: ...
    def replace_history(self, history: str | Path | dict[str, object]) -> None: ...
    @property
    def history_digest(self) -> str | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Store: ...
    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> bool: ...
